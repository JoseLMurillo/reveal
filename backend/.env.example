# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info

# Supabase (solo backend)
SUPABASE_URL=https://your-project.supabase.co
# Opción A: service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Opción B: secret key (sb_secret_...). El backend la usa como clave de
# servidor si SUPABASE_SERVICE_ROLE_KEY está vacía. Nunca va al frontend.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=rollo-originals

# Sesiones administrativas
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_SESSION_IDLE_SECONDS=3600
COOKIE_DOMAIN=

# Sesiones de participante
PARTICIPANT_SESSION_TTL_SECONDS=2592000

# Cargas
UPLOAD_SESSION_TTL_SECONDS=900
MAX_FILES_PER_UPLOAD=10
SIGNED_URL_TTL_SECONDS=3600

# Limpieza
CLEANUP_INTERVAL_SECONDS=300
